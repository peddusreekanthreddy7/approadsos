{
  "expo": {
    "name": "RoadSOS",
    "slug": "roadsos",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#080C14",
      "resizeMode": "contain"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RoadSOS to access camera for Night Beacon emergency strobe."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow RoadSOS to use location for emergency response."
        }
      ]
    ],
    "android": {
      "package": "com.teamstatus200.roadsos",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#080C14"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "SEND_SMS",
        "CAMERA",
        "VIBRATE",
        "FLASHLIGHT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBSfoWVEcRW9qIbTnAbm8XOaSRLXBdZFPY"
        }
      }
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RoadSOS needs your location for emergency services.",
        "NSCameraUsageDescription": "RoadSOS uses camera for Night Beacon strobe."
      }
    },
    "extra": {
      "eas": {
        "projectId": "a8a0e5b5-06ef-4b54-8d85-dc89770defa9"
      }
    },
    "owner": "sreekanth_reddy"
  }
}
